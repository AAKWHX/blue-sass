# Server-only owner bootstrap identity. Leave blank in committed templates.
PLATFORM_OWNER_EMAIL=

# ---------------------------------------------------------------------------
# Neon Postgres — copy the "Pooled connection" string from the Neon dashboard.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------------------
# Auth.js — generate with:  npx auth secret     (or: openssl rand -base64 32)
# ---------------------------------------------------------------------------
AUTH_SECRET=replace-me-with-a-32-byte-random-string

# Google OAuth web client. Production redirect URI:
# https://www.bluesass.nl/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Only needed for local development; Vercel sets this automatically.
AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Seeding — the first super admin created by `npm run db:seed`.
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@aakwhx.com
SEED_ADMIN_PASSWORD=change-this-password

# ---------------------------------------------------------------------------
# Resend — transactional email (account confirmation links).
# Without it verification delivery fails safely; tokens are never logged.
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="Blue Sass <help@bluesass.nl>"
# Production always requires email verification.
REQUIRE_EMAIL_VERIFICATION=true

# PayPal Checkout. Use Sandbox app credentials while developing. The client
# ID is public by design; the secret is read only by server routes.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Public publisher identifier; ads load only on eligible public tool/content pages.
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=ca-pub-2458310650397376
NEXT_PUBLIC_ADSENSE_ENABLED=true
# AI_MODEL is required. Vercel uses automatic OIDC; an API key is optional locally.
AI_GATEWAY_API_KEY=
AI_MODEL=
GOOGLE_PAGESPEED_API_KEY=
# Optional: existing registered webhook ID. Otherwise resolved from this app.
PAYPAL_WEBHOOK_ID=

# Absolute origin used to build links inside emails. Falls back to the Vercel
# deployment URL, then to the incoming request host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel REST API — server-only credentials used by the customer hosting area.
# Create a narrowly scoped token for the Blue Sass hosting team. Never expose it
# with a NEXT_PUBLIC_ prefix. Team ID is optional for personal Vercel accounts.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
